{
  "name": "agrilink",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Agrilink - agricultural e-commerce marketplace connecting farmers and buyers directly. Frontend-only application (React 18 + Vite + Tailwind CSS 3.4). Backend (Express + Mongoose + MongoDB) has been removed from this delivery; see backend-archived/ for the removed server source.",
  "scripts": {
    "dev": "vite --port 5199 --strictPort --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "preview": "vite preview --config frontend/vite.config.js",
    "test:client": "vitest run --config frontend/vitest.config.client.js",
    "test": "npm run test:client",
    "test:ci": "npm run test:client"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "vitest": "^3.2.7"
  }
}
