{
  "name": "agrilink",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Agrilink - agricultural e-commerce marketplace connecting farmers and buyers directly.",
  "scripts": {
    "dev": "vite --port 5199 --strictPort --config frontend/vite.config.js",
    "dev:api": "node --watch server/index.js",
    "build": "vite build --config frontend/vite.config.js",
    "preview": "vite preview --config frontend/vite.config.js",
    "test:server": "AGRILINK_TEST_DB=agrilink_test vitest run --config vitest.config.server.js",
    "test:client": "vitest run --config frontend/vitest.config.client.js",
    "test": "npm run test:server && npm run test:client",
    "test:ci": "AGRILINK_TEST_DB=agrilink_test npm run test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.454.0",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.47",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "vitest": "^3.2.7"
  }
}
