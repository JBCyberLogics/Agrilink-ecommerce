# Agrilink API environment template — copy to server/.env and fill in.
#
# MONGODB_URI: your Atlas "mongodb+srv://..." URI works. If Node throws
# `querySrv` errors on your machine/DNS, use the seedlist form instead:
#   mongodb://<user>:<pass>@shard-00-00:27017,shard-00-01:27017,shard-00-02:27017/
#     ?replicaSet=<cluster-zero>&authSource=admin&tls=true
MONGODB_URI="mongodb+srv://<db_user>:<db_password>@agrilink.n0xvqzx.mongodb.net"
DB_NAME=agrilink

# openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000

# Seed demo farmer (created on API boot if missing) — powers /?demo=farmer
DEMO_EMAIL=demo@agrilink.co.ke
DEMO_PASSWORD=demo1234

# --- Optional integrations (placeholders only — never real credentials) ---

# Email/SMTP provider for password recovery (AUTH-RECOVERY-001).
# Without these, password recovery is explicitly unavailable — the UI shows
# an honest "not configured" state rather than pretending an email was sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=example@example.com
# SMTP_PASS=change-me
# SMTP_FROM=Agrilink <noreply@example.com>

# Redis URL for distributed rate limiting when running multiple backend
# instances (SECURITY-001). Single-node deployments use the in-memory
# limiter in server/middleware/rateLimit.js and do not require Redis.
# REDIS_URL=redis://localhost:6379

# Payment provider secret key (future ORDERS/checkout stage). Payments are
# intentionally not activated in this release — orders are created as
# Pending/Unpaid and honestly presented as not-yet-paid.
# STRIPE_SECRET_KEY=sk_test_change-me

# Dedicated test database name for automated tests (TEST-001). Tests connect
# to the same Atlas cluster but a separate database so real data is never
# touched. Run with: AGRILINK_TEST_DB=agrilink_test npm run test:server
# AGRILINK_TEST_DB=agrilink_test
