# Agrilink API environment template — copy to server/.env and fill in.
#
# MONGODB_URI: your Atlas "mongodb+srv://..." URI works. If Node throws
# `querySrv` errors on your machine/DNS, use the seedlist form instead:
#   mongodb://<user>:<pass>@shard-00-00:27017,shard-00-01:27017,shard-00-02:27017/
#     ?replicaSet=<cluster-zero>&authSource=admin&tls=true
MONGODB_URI="mongodb+srv://<db_user>:<db_password>@agrilink.n0xvqzx.mongodb.net"
DB_NAME=agrilink

# openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000

# Seed demo farmer (created on API boot if missing) — powers /?demo=farmer
DEMO_EMAIL=demo@agrilink.co.ke
DEMO_PASSWORD=demo1234
